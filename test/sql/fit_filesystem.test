# name: test/sql/fit_filesystem.test
# description: FIT files are read through DuckDB's virtual FileSystem, not std::fstream (issue #1)
# group: [sql]

require fit

# Baseline: read the sample directly. All assertions below are compared against this.
query I
SELECT COUNT(*) FROM fit_records('sample.fit');
----
7923

# --- Globbing goes through FileSystem::Glob ---

# A wildcard pattern that matches the sample resolves and reads the same data.
query I
SELECT COUNT(*) FROM fit_records('sample.fi*');
----
7923

# A bracket-class glob that matches the sample also resolves via FileSystem::Glob.
query I
SELECT COUNT(*) FROM fit_records('[s]ample.fit');
----
7923

# A wildcard pattern matching nothing returns an empty result (valid schema, 0 rows),
# rather than raising an error.
query I
SELECT COUNT(*) FROM fit_records('nonexistent_*.fit');
----
0

query I
SELECT COUNT(*) FROM fit_activities('nonexistent_*.fit');
----
0

# --- Error semantics for a concrete (non-glob) path that does not exist ---
statement error
SELECT * FROM fit_records('nonexistent.fit');
----
